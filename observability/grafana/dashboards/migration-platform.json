{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Migration jobs by status",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (state) (migration_platform_migration_jobs)", "legendFormat": "{{state}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Queue wait p50 / p95",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(migration_platform_migration_queue_wait_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(migration_platform_migration_queue_wait_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Migration duration p95",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, result) (rate(migration_platform_migration_duration_seconds_bucket[5m])))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Rows and batches processed",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum by (operation) (rate(migration_platform_migration_rows_processed_total[5m]))", "legendFormat": "rows {{operation}}", "refId": "A"},
        {"expr": "sum by (operation) (rate(migration_platform_migration_batches_processed_total[5m]))", "legendFormat": "batches {{operation}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Database connection pools",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "migration_platform_db_pool_connections", "legendFormat": "{{pool}} {{state}}", "refId": "A"},
        {"expr": "migration_platform_db_pool_total_connections", "legendFormat": "{{pool}} total", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Pool acquire wait",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "rate(migration_platform_db_pool_acquire_wait_seconds[5m])", "legendFormat": "{{pool}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["migration", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Migration Platform Observability",
  "uid": "migration-platform",
  "version": 1
}
